#!/bin/sh
# Build /usr/src/php the way the official image built the PHP it replaces and
# install it under /out, together with the source tarball and our metadata.
#
#   compile <branch-dir>
set -eu

meta=$(cd "$1" && pwd)
. "$meta/elts.env"
jobs=${MAKE_JOBS:-$(nproc)}
out=/out

# The PHP being replaced recorded its configure flags; reuse them verbatim.
flags=$(php-config --configure-options)

cd /usr/src/php
export CFLAGS="$PHP_CFLAGS" CPPFLAGS="$PHP_CPPFLAGS" LDFLAGS="$PHP_LDFLAGS"
# shellcheck disable=SC2086 # split on purpose: the flags contain no spaces
./configure $flags
make -j"$jobs"

# Everything `make install` does except PEAR, which is plain PHP code the
# base image already has and would be downloaded again.
targets=$(sed -n 's/^install_targets *= *//p' Makefile | tr ' ' '\n' | grep -vx 'install-pear' | tr '\n' ' ')
# apxs insists on writing a LoadModule file and a libtool archive; the base
# image has the former and never had the latter.
mkdir -p "$out/etc/apache2/mods-available"
make install INSTALL_ROOT="$out" install_targets="$targets"
rm -rf "${out:?}/etc" "$out"/usr/lib/apache2/modules/*.la

find "$out" -type f -perm /0111 -exec sh -c 'strip --strip-all "$@" 2>/dev/null || :' _ {} +
mkdir -p "$out$PHP_INI_DIR"
cp php.ini-development php.ini-production "$out$PHP_INI_DIR/"

# The tarball docker-php-source and docker-php-ext-install work from: the
# patched tree, plus whatever generated sources (lexers from .re files) the
# build had to regenerate because a patch changed their input.
grep -v '^symlink ' /usr/src/php.files | cut -c67- >/tmp/files
{ grep '^symlink ' /usr/src/php.files || :; } | sed 's/^symlink  //; s/ -> .*//' >>/tmp/files
LC_ALL=C sort /tmp/files >/tmp/files.sorted
regenerated=$(find . -type f -newer /usr/src/php.files | LC_ALL=C sort | LC_ALL=C comm -12 - /tmp/files.sorted)
echo "compile: regenerated by the build: ${regenerated:-nothing}"
mkdir -p "$out/usr/src"
tar -cJf "$out/usr/src/php.tar.xz" --no-recursion -T /tmp/files \
	--owner=0 --group=0 --numeric-owner \
	--transform "s,^\./,php-$PHP_VERSION/,"

share=$out/usr/local/share/php-elts
mkdir -p "$share"
cp "$meta/elts.env" "$meta/series" "$meta/FIXES.md" "$meta/elts/$DSC" "$share/"
cp /usr/src/php.files "$share/source-tree.sha256"
